{
  "manifestVersion": 1,
  "id": "advanced-pr-dev",
  "publisher": "NebulaImprover",
  "version": "0.8.3",
  "name": "Advanced PR Review (Development)",
  "description": "Development build of Advanced PR Review.",
  "icons": { "default": "images/icon.png" },
  "categories": ["Azure Repos"],
  "baseUri": "https://192.168.1.128:3000",
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "scopes": ["vso.code_write", "vso.threads_full", "vso.extension.data_write"],
  "contributions": [
    {
      "id": "advanced-pr-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Guided Review (Dev)",
        "title": "Guided Review",
        "uri": "index.html"
      }
    }
  ],
  "content": { "details": { "path": "overview.md" } },
  "files": [{ "path": "images/icon.png", "addressable": true }]
}
