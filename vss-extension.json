{
  "manifestVersion": 1,
  "id": "advanced-pr",
  "publisher": "NebulaImprover",
  "version": "0.2.0",
  "name": "Advanced PR Review",
  "description": "Review large pull requests in explicit steps, with comments inline in the diff.",
  "public": false,
  "icons": { "default": "images/icon.png" },
  "categories": ["Azure Repos"],
  "tags": ["pull request", "code review", "git", "diff", "comments"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "scopes": ["vso.code_write", "vso.threads_full", "vso.extension.data_write"],
  "links": {
    "repository": { "uri": "https://github.com/williamverdolini/advanced-pr" },
    "issues": { "uri": "https://github.com/williamverdolini/advanced-pr/issues" }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/williamverdolini/advanced-pr"
  },
  "contributions": [
    {
      "id": "advanced-pr-tab",
      "type": "ms.vss-web.tab",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Guided Review",
        "title": "Guided Review",
        "uri": "dist/tab/index.html"
      }
    }
  ],
  "content": { "details": { "path": "overview.md" } },
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "images/icon.png", "addressable": true }
  ]
}
