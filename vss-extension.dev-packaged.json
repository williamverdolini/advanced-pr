{
  "manifestVersion": 1,
  "id": "advanced-pr-dev",
  "publisher": "NebulaImprover",
  "version": "0.5.1",
  "name": "Advanced PR Review (Development)",
  "description": "Packaged rehearsal of Advanced PR Review, served from the Marketplace CDN.",
  "public": false,
  "icons": {
    "default": "images/icon.png"
  },
  "categories": [
    "Azure Repos"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.code_write",
    "vso.threads_full",
    "vso.extension.data_write"
  ],
  "contributions": [
    {
      "id": "advanced-pr-tab",
      "type": "ms.vss-web.tab",
      "targets": [
        "ms.vss-code-web.pr-tabs"
      ],
      "properties": {
        "name": "Guided Review (Dev)",
        "title": "Guided Review",
        "uri": "dist/tab/index.html"
      }
    }
  ],
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images/icon.png",
      "addressable": true
    }
  ]
}
